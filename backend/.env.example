# Google Places API (New). Keep this key on the backend only.
GOOGLE_MAPS_API_KEY=

# جديد — إعدادات قاعدة البيانات للمحلي أو بيئة النشر.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=explore_hail

# جديد — قيمة عشوائية طويلة وخاصة لتوقيع رموز تسجيل الدخول.
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret

# جديد — إعداد Resend لإرسال نتيجة الحجز بالبريد، اتركهما فارغين إلى حين الإعداد.
RESEND_API_KEY=
EMAIL_FROM=
