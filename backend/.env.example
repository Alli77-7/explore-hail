# Copy this file to backend/.env and fill in the values you need.
PORT=3000

# demo uses checked-in seed data; mysql uses a connected database.
DATABASE_MODE=demo
DB_HOST=localhost
DB_PORT=3306
DB_NAME=explore_hail
DB_USER=root
DB_PASSWORD=

# Required for production authentication. Generate a long random value.
JWT_SECRET=replace-with-a-long-random-secret

# Optional smart planner configuration.
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b
AI_API_URL=https://api.groq.com/openai/v1/chat/completions

# Optional Google Places API (New). Keep the key on the backend only.
GOOGLE_MAPS_API_KEY=

# Optional booking email configuration.
RESEND_API_KEY=
EMAIL_FROM=
